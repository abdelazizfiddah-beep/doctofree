{% extends 'admin/base.html.twig' %}
{% block title %}{{ medicament.nom }}{% endblock %}
{% block admin_content %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>{{ medicament.nom }}</h2>
    <a href="{{ path('app_admin_medicament_index') }}" class="btn btn-outline-secondary btn-sm">Retour à la liste</a>
</div>

<div class="card">
    <div class="card-header">Informations</div>
    <div class="card-body">
        <div class="row mb-2">
            <div class="col-sm-3 text-muted">ID</div>
            <div class="col-sm-9">{{ medicament.id }}</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3 text-muted">Nom</div>
            <div class="col-sm-9">{{ medicament.nom }}</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3 text-muted">DCI</div>
            <div class="col-sm-9">{{ medicament.dci ?? '—' }}</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3 text-muted">Forme</div>
            <div class="col-sm-9">{{ medicament.forme ?? '—' }}</div>
        </div>
        <div class="row">
            <div class="col-sm-3 text-muted">Dosage</div>
            <div class="col-sm-9">{{ medicament.dosage ?? '—' }}</div>
        </div>
    </div>
</div>

{% endblock %}
