{% extends 'admin/base.html.twig' %}
{% block title %}Patients{% endblock %}
{% block admin_content %}

<h2 class="mb-4">Patients</h2>

<div class="d-flex fw-bold border-bottom pb-2 mb-2 text-muted" style="font-size:0.85rem">
    <div style="width:60px">ID</div>
    <div style="width:160px">Nom</div>
    <div style="width:160px">Prénom</div>
    <div style="width:150px">Date de naissance</div>
    <div style="width:140px">Téléphone</div>
    <div></div>
</div>

{% for patient in patients %}
<div class="d-flex align-items-center border-bottom py-2">
    <div style="width:60px">{{ patient.id }}</div>
    <div style="width:160px">{{ patient.nom }}</div>
    <div style="width:160px">{{ patient.prenom }}</div>
    <div style="width:150px">{{ patient.dateNaissance ? patient.dateNaissance|date('d/m/Y') : '—' }}</div>
    <div style="width:140px">{{ patient.telephone ?? '—' }}</div>
    <div>
        <a href="{{ path('app_admin_patient_show', {id: patient.id}) }}" class="btn btn-sm btn-outline-dark">Voir</a>
    </div>
</div>
{% else %}
<div class="text-muted py-3">Aucun patient enregistré.</div>
{% endfor %}

{% endblock %}
